cabal-version:   3.0
name:            kelgroups
version:         0.1.0.0
synopsis:        Groups of KERI identities over hosted member KELs
description:
  A server and library for groups of KERI identities. The
  server hosts each member's own KEL (keri-hs); group actions
  are interaction events in the signer's KEL, chained per group
  by prev links, admitted under the membership and admin rules
  of a Lean 4 model, and stored in SQLite.

license:         Apache-2.0
license-file:    LICENSE
copyright:       (c) 2026 Paolo Veronelli
author:          Paolo Veronelli
maintainer:      paolo.veronelli@gmail.com
category:        Cryptography
build-type:      Simple
extra-doc-files: README.md

common language
  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings
    StrictData

common opts-lib
  ghc-options:
    -Wall -Werror -Wunused-imports -Wunused-packages
    -Wmissing-export-lists -Wname-shadowing -Wredundant-constraints

library
  import:          language, opts-lib
  hs-source-dirs:  lib
  exposed-modules:
    KelGroups.Group
    KelGroups.Kel
    KelGroups.Kel.Codec
    KelGroups.Kel.Store
    KelGroups.Server
    KelGroups.Vote.State
    KelGroups.Vote.Types

  build-depends:
    , aeson          >=2.1  && <2.3
    , base           >=4.18 && <5
    , bytestring     >=0.11 && <0.13
    , containers     >=0.6  && <0.8
    , http-types     >=0.12 && <0.13
    , keri-hs
    , sqlite-simple  >=0.4  && <0.5
    , stm            >=2.5  && <2.7
    , text           >=2.0  && <2.2
    , wai            >=3.2  && <3.3

executable kelgroups-server
  import:         language, opts-lib
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded
  build-depends:
    , base            >=4.18 && <5
    , kelgroups
    , wai-app-static  >=3.1  && <3.2
    , warp            >=3.3  && <3.5

common opts-test
  ghc-options: -Wall -Werror -Wunused-imports -Wunused-packages -threaded

test-suite invariants
  import:             language, opts-test
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Main.hs
  build-tool-depends: kelgroups:kelgroups-server
  other-modules:
    GroupFixtures
    GroupMembershipServerSpec
    GroupMembershipSpec
    GroupMembershipStoreSpec
    GroupServerSpec
    GroupSpec
    GroupStoreSpec
    GroupWorld
    MemberKelFixtures
    MemberKelServerSpec
    MemberKelSpec
    MemberKelStoreSpec
    ServerIdentitySpec

  build-depends:
    , aeson           >=2.1  && <2.3
    , async           >=2.2  && <2.3
    , base            >=4.18 && <5
    , bytestring      >=0.11 && <0.13
    , containers      >=0.6  && <0.8
    , crypton         >=0.34 && <2
    , directory       >=1.3  && <1.4
    , hspec           >=2.11 && <2.12
    , http-client     >=0.7  && <0.8
    , http-types      >=0.12 && <0.13
    , kelgroups
    , keri-hs
    , memory          >=0.16 && <1
    , network         >=3.1  && <3.3
    , process         >=1.6  && <1.7
    , QuickCheck      >=2.14 && <2.16
    , scientific      >=0.3  && <0.4
    , sqlite-simple   >=0.4  && <0.5
    , temporary       >=1.3  && <1.4
    , text            >=2.0  && <2.2
    , wai             >=3.2  && <3.3
    , wai-app-static  >=3.1  && <3.2
    , warp            >=3.3  && <3.5
